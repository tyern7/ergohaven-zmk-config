#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        la: la {
            compatible = "zmk,behavior-macro-one-param";
            display-name = "Layer Activate";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_tap>,
                <&kp 0>,
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER &kp LSHFT &kp LCTRL &kp LALT &kp LGUI>;
        };

        enc_vol: enc_vol {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENC_VOL";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <175>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49 55 56 57 58 59>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <175>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54>;
            hold-trigger-on-release;
        };

        backspace_behaviour: backspace_behaviour {
            compatible = "zmk,behavior-mod-morph";
            label = "BACKSPACE_BEHAVIOUR";
            bindings = <&kp H>, <&kp BACKSPACE>;

            #binding-cells = <0>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        word_backspace_behaviour: word_backspace_behaviour {
            compatible = "zmk,behavior-mod-morph";
            label = "WORD_BACKSPACE_BEHAVIOUR";
            bindings = <&kp W>, <&kp LA(BACKSPACE)>;

            #binding-cells = <0>;
            mods = <(MOD_RCTL|MOD_LCTL)>;
        };

        colon_semicolon: colon_semicolon {
            compatible = "zmk,behavior-mod-morph";
            label = "COLON_SEMICOLON";
            bindings = <&kp LS(SEMICOLON)>, <&kp SEMICOLON>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        inverse_1: inverse_1 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_1";
            bindings = <&kp EXCL>, <&kp KP_NUMBER_1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        inverse_2: inverse_2 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_2";
            bindings = <&kp AT_SIGN>, <&kp KP_NUMBER_2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        inverse_3: inverse_3 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_3";
            bindings = <&kp HASH>, <&kp KP_NUMBER_3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        inverse_4: inverse_4 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_4";
            bindings = <&kp DOLLAR>, <&kp KP_NUMBER_4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        inverse_5: inverse_5 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_5";
            bindings = <&kp PERCENT>, <&kp KP_NUMBER_5>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        inverse_6: inverse_6 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_6";
            bindings = <&kp CARET>, <&kp KP_NUMBER_6>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        inverse_7: inverse_7 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_7";
            bindings = <&kp AMPERSAND>, <&kp KP_NUMBER_7>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        inverse_8: inverse_8 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_8";
            bindings = <&kp ASTERISK>, <&kp KP_NUMBER_8>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        inverse_9: inverse_9 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_9";
            bindings = <&kp LPAR>, <&kp KP_NUMBER_9>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        inverse_0: inverse_0 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_0";
            bindings = <&kp RPAR>, <&kp KP_NUMBER_0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        layer_morph_2_4: layer_morph_2_4 {
            compatible = "zmk,behavior-mod-morph";
            label = "LAYER_MORPH_2_4";
            bindings = <&mo 4>, <&mo 0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        layer_morph_1_5: layer_morph_1_5 {
            compatible = "zmk,behavior-mod-morph";
            label = "LAYER_MORPH_1_5";
            bindings = <&mo 1>, <&mo 0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mac_f1: mac_f1 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F1";
            bindings = <&kp C_BRIGHTNESS_DEC>, <&kp F1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mac_f2: mac_f2 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F2";
            bindings = <&kp C_BRIGHTNESS_INC>, <&kp F2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mac_f3: mac_f3 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F3";
            bindings = <&kp F13>, <&kp F3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mac_f4: mac_f4 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F4";
            bindings = <&kp F14>, <&kp F4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mac_f5: mac_f5 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F5";
            bindings = <&kp F15>, <&kp F5>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mac_f6: mac_f6 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F6";
            bindings = <&kp F16>, <&kp F6>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mac_f7: mac_f7 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F7";
            bindings = <&kp C_NEXT>, <&kp F7>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mac_f8: mac_f8 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F8";
            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            bindings = <&kp LG(C_PLAY_PAUSE)>, <&kp F8>;
        };

        mac_f9: mac_f9 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F9";
            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            bindings = <&kp C_NEXT>, <&kp F9>;
        };

        mac_f10: mac_f10 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F10";
            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            bindings = <&kp C_MUTE>, <&kp F10>;
        };

        mac_f11: mac_f11 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F11";
            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            bindings = <&kp C_VOLUME_DOWN>, <&kp F11>;
        };

        mac_f12: mac_f12 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F12";
            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            bindings = <&kp C_VOLUME_UP>, <&kp F12>;
        };

        mac_f1_and_1: mac_f1_and_1 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F1_AND_1";
            bindings = <&mac_f1>, <&kp N1>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mac_f2_and_2: mac_f2_and_2 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F2_AND_2";
            bindings = <&mac_f2>, <&kp N2>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mac_f3_and_3: mac_f3_and_3 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F3_AND_3";
            bindings = <&mac_f3>, <&kp N3>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mac_f4_and_4: mac_f4_and_4 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F4_AND_4";
            bindings = <&mac_f4>, <&kp N4>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mac_f5_and_5: mac_f5_and_5 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F5_AND_5";
            bindings = <&mac_f5>, <&kp N5>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mac_f6_and_6: mac_f6_and_6 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F6_AND_6";
            bindings = <&mac_f6>, <&kp N6>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mac_f7_and_7: mac_f7_and_7 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F7_AND_7";
            bindings = <&mac_f7>, <&kp KP_NUMBER_7>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mac_f8_and_8: mac_f8_and_8 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F8_AND_8";
            bindings = <&mac_f8>, <&kp KP_NUMBER_8>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mac_f9_and_9: mac_f9_and_9 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F9_AND_9";
            bindings = <&mac_f9>, <&kp KP_NUMBER_9>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        zero_and_zero: zero_and_zero {
            compatible = "zmk,behavior-mod-morph";
            label = "ZERO_AND_ZERO";
            bindings = <&kp KP_NUMBER_0>, <&kp KP_NUMBER_0>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        hold_tap: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP";
            bindings = <&mo>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cmben {
            bindings = <&layer_en>;
            key-positions = <15 16>;
        };

        cmbru {
            bindings = <&layer_ru>;
            key-positions = <15 16>;
        };
    };

    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N2))>;
            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N1))>;
            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 4 &to_en>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 4 &to_ru>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru>;

            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        nvim_toggle_repl: nvim_toggle_dap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp R &kp R>;
            label = "NVIM_TOGGLE_DAP";
        };

        nvim_toggle_dap: nvim_toggle_de {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SPACE &kp D &kp U>;
            label = "NVIM_TOGGLE_DE";
        };

        mac_screenshot_full: mac_screen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI &kp LEFT_SHIFT &kp NUMBER_3>;
            label = "MAC_SCREEN";
        };

        mac_screenshot_area: mac_screenshot_area {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI &kp LEFT_SHIFT &kp NUMBER_4>;
            label = "MAC_SCREENSHOT_AREA";
        };

        mac_screenshot_panel: mac_screenshot_window {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI &kp LEFT_SHIFT &kp NUMBER_5>;
            label = "MAC_SCREENSHOT_WINDOW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "Base";
            bindings = <
&none    &none  &word_backspace_behaviour  &kp E  &kp R             &kp T                             &kp Y                 &kp U                 &kp I      &kp O    &none             &none
&none    &none  &kp S                      &kp D  &kp F             &kp G                             &backspace_behaviour  &kp J                 &kp K      &kp L    &none             &none
&kp Q    &kp A  &kp X                      &kp C  &kp V             &kp B                             &kp N                 &kp M                 &kp COMMA  &kp DOT  &colon_semicolon  &kp P
&kp TAB  &kp Z  &none                      &none  &mkp LCLK         &kp LEFT_GUI  &kp ESC    &kp TAB  &kp ENTER             &mkp RCLK             &none      &none    &kp BACKSLASH     &kp SLASH
                &none                      &none  &sk LEFT_CONTROL  &kp SPACE     &mo 2      &la 1    &kp LEFT_SHIFT        &hold_tap 4 LEFT_ALT  &none      &none
            >;
        };

        sym {
            bindings = <
&none           &inverse_1        &inverse_2         &inverse_3     &inverse_4        &inverse_5                  &inverse_6  &inverse_7      &inverse_8        &inverse_9      &inverse_0       &none
&none           &inverse_1        &kp GRAVE          &kp SQT        &kp DQT           &kp MINUS                   &kp PLUS    &sk LEFT_SHIFT  &sk LEFT_CONTROL  &sk LEFT_ALT    &inverse_0       &none
&kp LEFT_SHIFT  &kp TILDE         &kp RIGHT_BRACKET  &kp LESS_THAN  &kp GREATER_THAN  &kp UNDER                   &kp EQUAL   &none           &kp PIPE          &kp LEFT_BRACE  &sk LEFT_GUI     &sk LEFT_SHIFT
&none           &kp LEFT_BRACKET  &none              &none          &none             &none       &none    &none  &none       &none           &none             &none           &kp RIGHT_BRACE  &none
                                  &none              &none          &none             &kp SPACE   &mo 2    &none  &none       &none           &none             &none
            >;
        };

        nav {
            bindings = <
&none  &none            &kp LA(TAB)   &kp LG(TAB)       &none            &kp ESC                    &kp ESC    &kp HOME        &kp END     &kp PAGE_UP  &kp DELETE       &none
&none  &kp LC(TAB)      &sk LEFT_ALT  &sk LEFT_CONTROL  &sk LEFT_SHIFT   &kp ENTER                  &kp ENTER  &kp LEFT_ARROW  &kp DOWN    &kp UP       &kp PAGE_DOWN    &none
&none  &sk LEFT_GUI     &none         &none             &kp PRINTSCREEN  &kp TAB                    &kp TAB    &kp LA(LEFT)    &kp LA(UP)  &kp LA(UP)   &kp RIGHT_ARROW  &none
&none  &kp LA(LS(TAB))  &none         &none             &none            &none      &none    &none  &none      &none           &none       &none        &kp LA(RIGHT)    &none
                        &none         &none             &none            &none      &none    &mo 1  &none      &none           &none       &none
            >;

            display-name = "Nav";
        };

        num {
            bindings = <
&none           &none         &kp N2        &kp N3            &kp N4          &kp N5                    &kp N6    &kp N7          &kp N8            &kp N9        &none         &none
&none           &kp N1        &sk LEFT_ALT  &sk LEFT_CONTROL  &sk LEFT_SHIFT  &mac_f11                  &mac_f12  &sk LEFT_SHIFT  &sk LEFT_CONTROL  &sk LEFT_ALT  &kp N0        &none
&kp LEFT_SHIFT  &sk LEFT_GUI  &mac_f2       &mac_f3           &mac_f4         &mac_f5                   &mac_f6   &mac_f7         &mac_f8           &mac_f9       &sk LEFT_GUI  &kp LEFT_SHIFT
&none           &mac_f1       &none         &none             &none           &none     &none    &none  &none     &none           &none             &none         &mac_f10      &none
                              &none         &none             &none           &none     &none    &none  &none     &none           &none             &none
            >;
        };

        alt_sym {
            bindings = <
&none  &none  &none  &none  &none  &none                  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none  &none
              &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
            >;
        };

        cmd_layer {
            bindings = <
&kp A  &none  &none  &none  &none          &none                  &bt BT_SEL 0  &bt BT_SEL 1          &bt BT_SEL 2          &bt BT_SEL 3           &bt BT_SEL 4  &bt BT_CLR_ALL
&none  &none  &none  &none  &kp LC(LG(Q))  &none                  &bootloader   &mac_screenshot_full  &mac_screenshot_area  &mac_screenshot_panel  &none         &studio_unlock
&to 0  &none  &none  &none  &none          &none                  &out OUT_BLE  &none                 &none                 &none                  &none         &none
&none  &none  &none  &none  &none          &none  &none    &none  &out OUT_USB  &none                 &none                 &none                  &none         &none
              &none  &none  &none          &none  &none    &none  &none         &none                 &none                 &none
            >;

            display-name = "Adjust";
        };

        game {
            bindings = <
&none  &none  &none  &none  &none  &none                  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none                  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none  &none
              &none  &none  &none  &none  &none    &none  &none  &none  &none  &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        activate_num {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
