#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        inverse_1: inverse_1 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_1";
            bindings = <&kp EXCL>, <&kp KP_NUMBER_1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        inverse_2: inverse_2 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_2";
            bindings = <&kp AT_SIGN>, <&kp KP_NUMBER_2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        inverse_3: inverse_3 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_3";
            bindings = <&kp HASH>, <&kp KP_NUMBER_3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        inverse_4: inverse_4 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_4";
            bindings = <&kp DOLLAR>, <&kp KP_NUMBER_4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        inverse_5: inverse_5 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_5";
            bindings = <&kp PERCENT>, <&kp KP_NUMBER_5>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        inverse_6: inverse_6 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_6";
            bindings = <&kp CARET>, <&kp KP_NUMBER_6>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        inverse_7: inverse_7 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_7";
            bindings = <&kp AMPERSAND>, <&kp KP_NUMBER_7>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        inverse_8: inverse_8 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_8";
            bindings = <&kp ASTERISK>, <&kp KP_NUMBER_8>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        inverse_9: inverse_9 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_9";
            bindings = <&kp LPAR>, <&kp KP_NUMBER_9>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        inverse_0: inverse_0 {
            compatible = "zmk,behavior-mod-morph";
            label = "INVERSE_0";
            bindings = <&kp RPAR>, <&kp KP_NUMBER_0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        layer_morph_2_4: layer_morph_2_4 {
            compatible = "zmk,behavior-mod-morph";
            label = "LAYER_MORPH_2_4";
            bindings = <&mo 2>, <&mo 0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        layer_morph_1_5: layer_morph_1_5 {
            compatible = "zmk,behavior-mod-morph";
            label = "LAYER_MORPH_1_5";
            bindings = <&mo 1>, <&mo 0>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mac_f1: mac_f1 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F1";
            bindings = <&kp C_BRIGHTNESS_DEC>, <&kp F1>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mac_f2: mac_f2 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F2";
            bindings = <&kp C_BRIGHTNESS_INC>, <&kp F2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mac_f3: mac_f3 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F3";
            bindings = <&kp F13>, <&kp F3>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mac_f4: mac_f4 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F4";
            bindings = <&kp F14>, <&kp F4>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mac_f5: mac_f5 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F5";
            bindings = <&kp F15>, <&kp F5>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mac_f6: mac_f6 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F6";
            bindings = <&kp F16>, <&kp F6>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mac_f7: mac_f7 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F7";
            bindings = <&kp C_NEXT>, <&kp F7>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        mac_f8: mac_f8 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F8";
            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            bindings = <&kp LG(C_PLAY_PAUSE)>, <&kp F8>;
        };

        mac_f9: mac_f9 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F9";
            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            bindings = <&kp C_NEXT>, <&kp F9>;
        };

        mac_f10: mac_f10 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F10";
            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            bindings = <&kp C_MUTE>, <&kp F10>;
        };

        mac_f11: mac_f11 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F11";
            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            bindings = <&kp C_VOLUME_DOWN>, <&kp F11>;
        };

        mac_f12: mac_f12 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F12";
            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
            bindings = <&kp C_VOLUME_UP>, <&kp F12>;
        };

        mac_f1_and_1: mac_f1_and_1 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F1_AND_1";
            bindings = <&mac_f1>, <&kp N1>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mac_f2_and_2: mac_f2_and_2 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F2_AND_2";
            bindings = <&mac_f2>, <&kp N2>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mac_f3_and_3: mac_f3_and_3 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F3_AND_3";
            bindings = <&mac_f3>, <&kp N3>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mac_f4_and_4: mac_f4_and_4 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F4_AND_4";
            bindings = <&mac_f4>, <&kp N4>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mac_f5_and_5: mac_f5_and_5 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F5_AND_5";
            bindings = <&mac_f5>, <&kp N5>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mac_f6_and_6: mac_f6_and_6 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F6_AND_6";
            bindings = <&mac_f6>, <&kp N6>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mac_f7_and_7: mac_f7_and_7 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F7_AND_7";
            bindings = <&mac_f7>, <&kp KP_NUMBER_7>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mac_f8_and_8: mac_f8_and_8 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F8_AND_8";
            bindings = <&mac_f8>, <&kp KP_NUMBER_8>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        mac_f9_and_9: mac_f9_and_9 {
            compatible = "zmk,behavior-mod-morph";
            label = "MAC_F9_AND_9";
            bindings = <&mac_f9>, <&kp KP_NUMBER_9>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        zero_and_zero: zero_and_zero {
            compatible = "zmk,behavior-mod-morph";
            label = "ZERO_AND_ZERO";
            bindings = <&kp KP_NUMBER_0>, <&kp KP_NUMBER_0>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "Base";
            bindings = <
&none    &kp Q         &kp W  &kp E  &kp R         &kp T                                          &kp Y          &kp U             &kp I      &kp O    &kp P     &none
&none    &kp A         &kp S  &kp D  &kp F         &kp G                                          &kp H          &kp J             &kp K      &kp L    &kp SEMI  &none
&kp ESC  &kp Z         &kp X  &kp C  &kp V         &kp B                                          &kp N          &kp M             &kp COMMA  &kp DOT  &kp FSLH  &none
&kp TAB  &bt BT_SEL 0  &none  &none  &none         &mo 2             &mo 1        &kp TAB         &kp ENTER      &none             &none      &none    &none     &none
                       &none  &none  &kp LEFT_ALT  &kp LEFT_COMMAND  &kp SPACE    &kp LEFT_SHIFT  &kp BACKSPACE  &kp LEFT_CONTROL  &none      &none
            >;
        };

        sym_rowwise_esa {
            bindings = <
&none  &kp AT_SIGN  &kp LESS_THAN  &kp EQUAL  &kp GREATER_THAN  &kp LEFT_BRACKET                   &kp CARET  &kp DQT         &kp UNDER  &kp SQT          &inverse_0  &none
&none  &kp BSLH     &kp LPAR       &kp MINUS  &kp RPAR          &kp PLUS                           &kp PRCNT  &kp LEFT_BRACE  &kp SEMI   &kp RIGHT_BRACE  &none       &none
&none  &kp HASH     &kp ASTRK      &kp COLON  &kp FSLH          &kp RIGHT_BRACKET                  &none      &kp PIPE        &kp TILDE  &kp AMPERSAND    &kp DOLLAR  &none
&none  &none        &none          &none      &none             &none              &none    &none  &none      &none           &none      &none            &none       &none
                    &none          &none      &none             &none              &none    &none  &none      &none           &none      &none
            >;
        };

        nav {
            bindings = <
&none  &kp HOME            &kp PAGE_DOWN     &kp PAGE_UP         &kp END        &none                            &none   &kp N7  &kp N8  &kp N9  &mac_f10  &none
&none  &kp LEFT_ARROW      &kp UP_ARROW      &kp DOWN_ARROW      &kp RIGHT      &kp PRINTSCREEN                  &none   &kp N4  &kp N5  &kp N6  &mac_f11  &none
&none  &kp LA(LEFT_ARROW)  &kp LA(UP_ARROW)  &kp LA(DOWN_ARROW)  &kp LA(RIGHT)  &none                            &kp N0  &kp N1  &kp N2  &kp N3  &mac_f12  &none
&none  &none               &none             &none               &none          &none            &none    &none  &none   &none   &none   &none   &none     &none
                           &none             &none               &none          &none            &none    &none  &none   &none   &none   &none
            >;

            display-name = "Nav";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
